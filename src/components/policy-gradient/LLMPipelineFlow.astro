---
// src/components/policy-gradient/LLMPipelineFlow.astro
---

<div class="not-content llm-pipeline-container">
  <!-- Step 1: Pre-training -->
  <div class="pipeline-step-card step-pretrain">
    <div class="step-badge">STEP 1</div>
    <div class="step-title">사전학습 (Pre-training)</div>
    <div class="step-desc">기본 언어 패턴 습득</div>
  </div>

  <div class="pipeline-arrow">
    <svg viewBox="0 0 24 24">
      <path d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </div>

  <!-- Step 2: SFT -->
  <div class="pipeline-step-card step-sft">
    <div class="step-badge">STEP 2</div>
    <div class="step-title">지도 미세조정 (SFT)</div>
    <div class="step-desc">QA 형식 맥락 기반 응답 학습</div>
  </div>

  <div class="pipeline-arrow">
    <svg viewBox="0 0 24 24">
      <path d="M5 12h14M13 5l7 7-7 7" />
    </svg>
  </div>

  <!-- Step 3: RLHF Policy Gradient (주인공) -->
  <div class="pipeline-step-card step-rlhf">
    <div class="step-badge step-badge--active">STEP 3 </div>
    <div class="step-title">강화학습 (Policy Gradient)</div>
    <div class="step-desc">인간 선호도 및 보상 확률 밀도 최적화</div>
  </div>
</div>

<style>
  .llm-pipeline-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 1.25rem 0;
    width: 100%;
    box-sizing: border-box;
  }

  .pipeline-step-card {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    background-color: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 3px;
    transition: all 0.2s ease;
  }

  :root[data-theme='dark'] .pipeline-step-card {
    border-color: #334155;
    background-color: rgba(15, 23, 42, 0.6);
  }

  .step-badge {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #64748b;
  }

  :root[data-theme='dark'] .step-badge {
    color: #94a3b8;
  }

  .step-title {
    font-size: 13px;
    font-weight: 700;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :root[data-theme='dark'] .step-title {
    color: #f1f5f9;
  }

  .step-desc {
    font-size: 11px;
    color: #64748b;
    line-height: 1.35;
  }

  :root[data-theme='dark'] .step-desc {
    color: #94a3b8;
  }

  /* Step 2 SFT 포인트 */
  .step-sft {
    border-color: #bfdbfe;
    background-color: rgba(239, 246, 255, 0.7);
  }

  :root[data-theme='dark'] .step-sft {
    border-color: rgba(59, 130, 246, 0.3);
    background-color: rgba(30, 58, 138, 0.2);
  }

  .step-sft .step-badge {
    color: #2563eb;
  }

  :root[data-theme='dark'] .step-sft .step-badge {
    color: #60a5fa;
  }

  /* Step 3 RLHF 강조 */
  .step-rlhf {
    border: 1.5px solid #10b981;
    background-color: rgba(236, 253, 245, 0.9);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.12);
  }

  :root[data-theme='dark'] .step-rlhf {
    border-color: #059669;
    background-color: rgba(6, 78, 59, 0.25);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  }

  .step-badge--active {
    color: #059669 !important;
    font-weight: 800;
  }

  :root[data-theme='dark'] .step-badge--active {
    color: #34d399 !important;
  }

  .step-rlhf .step-title {
    color: #065f46;
  }

  :root[data-theme='dark'] .step-rlhf .step-title {
    color: #a7f3d0;
  }

  /* 연결 화살표 */
  .pipeline-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #94a3b8;
  }

  .pipeline-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 모바일 세로 배치 */
  @media (max-width: 42rem) {
    .llm-pipeline-container {
      flex-direction: column;
      gap: 6px;
    }

    .pipeline-step-card {
      width: 100%;
    }

    .pipeline-arrow svg {
      transform: rotate(90deg);
      width: 14px;
      height: 14px;
    }
  }
</style>
