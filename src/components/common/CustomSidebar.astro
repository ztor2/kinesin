---
import type { Props } from '@astrojs/starlight/props';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;

// 1. URL 경로에서 현재 1depth 카테고리 식별
const sectionMatch = pathname.match(/^\/(architecture|datasets|benchmark|papers)/i);
const activeSection = sectionMatch ? sectionMatch[1].toLowerCase() : null;

// 2. Starlight sidebar 내 매칭되는 그룹 찾기
let activeGroup = null;
if (activeSection) {
	activeGroup = sidebar.find(
		(entry) => entry.type === 'group' && entry.label.toLowerCase() === activeSection
	);
}

// 3. 하이브리드 네비게이션: 카테고리 내부에서는 해당 카테고리의 하위 목록만 집중 노출 (초기 화면 등 미매칭 시 비움)
const displaySublist = activeGroup ? activeGroup.entries : [];
---

<!-- 데스크톱 사이드바 (50rem 이상): 선택된 카테고리의 하위 목록만 노출 -->
<div class="desktop-sidebar sl-hidden md:sl-block">
	<SidebarPersister>
		<SidebarSublist sublist={displaySublist} nested={Boolean(activeGroup)} />
	</SidebarPersister>
</div>

<!-- 모바일 사이드바 (50rem 이하): 전체 카테고리와 하위 세부 아티클을 계층적으로 바로 탐색/선택 가능 -->
<div class="mobile-sidebar md:sl-hidden">
	<SidebarPersister>
		<SidebarSublist sublist={sidebar} />
	</SidebarPersister>
</div>

<style>
	/* 모바일 전용 트리형 카테고리 메뉴 스타일 */
	.mobile-sidebar {
		padding-top: 0.5rem;
		padding-bottom: 2rem;
	}

	.mobile-sidebar :global(details) {
		margin-bottom: 0.75rem;
	}

	.mobile-sidebar :global(summary) {
		padding: 0.5rem 0.35rem !important;
		border-radius: 8px;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.mobile-sidebar :global(summary:hover) {
		background-color: var(--sl-color-gray-6, rgba(0, 0, 0, 0.04));
	}

	.mobile-sidebar :global(summary .large) {
		font-size: 0.95rem !important;
		font-weight: 700 !important;
		color: var(--sl-color-text, #1c1917) !important;
		letter-spacing: -0.01em;
	}

	:root[data-theme='dark'] .mobile-sidebar :global(summary .large) {
		color: #f8fafc !important;
	}

	.mobile-sidebar :global(ul ul) {
		margin-top: 0.25rem;
		margin-bottom: 0.5rem;
	}

	.mobile-sidebar :global(ul ul li) {
		margin-inline-start: 0.5rem !important;
		border-inline-start: 1px solid var(--sl-color-hairline, #e2e8f0) !important;
		padding-inline-start: 0.6rem !important;
	}

	.mobile-sidebar :global(a) {
		padding: 0.45rem 0.5rem !important;
		font-size: 0.875rem !important;
		border-radius: 6px;
		line-height: 1.35;
	}
</style>
