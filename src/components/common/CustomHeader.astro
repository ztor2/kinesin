---
import type { Props } from '@astrojs/starlight/props';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import { Image } from 'astro:assets';
import logoSrc from '../../assets/kinesin.png';
import darkLogoSrc from '../../assets/kinesin-dark.png';

const pathname = Astro.url.pathname;
const isArchitecture = pathname.startsWith('/architecture');
const isDatasets = pathname.startsWith('/datasets');
const isBenchmark = pathname.startsWith('/benchmark');
const isPapers = pathname.startsWith('/papers');
---

<div class="header-container sl-flex">
	<!-- 좌측 영역: 로고, 사이트 타이틀, 데스크톱 사이드바 토글 버튼 (사이드바 폭과 1:1 일치) -->
	<div class="header-brand sl-flex">
		<div class="brand-title-box sl-flex">
			<a href="/" class="logo-link">
				<Image src={logoSrc} alt="Logo" width={64} height={64} class="site-logo site-logo--light" />
				<Image src={darkLogoSrc} alt="Logo" width={64} height={64} class="site-logo site-logo--dark" />
			</a>
			<SiteTitle {...Astro.props} />
		</div>

		<!-- 좌측 사이드바 접기/펼치기 데스크톱 토글 버튼 -->
		<button
			id="sidebar-toggle-btn"
			class="sidebar-toggle-btn"
			aria-label="사이드바 접기/펼치기"
			title="사이드바 접기/펼치기 (단축키: Cmd/Ctrl + B)"
		>
			<svg viewBox="0 0 24 24">
				<rect x="3" y="3" width="18" height="18" rx="3" ry="3" />
				<line x1="9" y1="3" x2="9" y2="21" />
			</svg>
		</button>
	</div>

	<!-- 중앙 영역: 1depth 하이브리드 네비게이션 탭 (본문 상단 정렬) -->
	<nav class="header-nav sl-flex" aria-label="메인 카테고리">
		<a
			href="/architecture/rope/"
			class:list={['nav-category-link', { active: isArchitecture }]}
		>
			<span>Architecture</span>
		</a>
		<a
			href="/datasets/"
			class:list={['nav-category-link', { active: isDatasets }]}
		>
			<span>Datasets</span>
		</a>
		<a
			href="/benchmark/"
			class:list={['nav-category-link', { active: isBenchmark }]}
		>
			<span>Benchmark</span>
		</a>
		<a
			href="/papers/pixelrag/"
			class:list={['nav-category-link', { active: isPapers }]}
		>
			<span>Papers</span>
		</a>
	</nav>

	<!-- 우측 영역: 검색, 언어, 테마 (TOC 상단 정렬, 모바일에서는 테마선택기 숨겨서 드로어 중복 방지) -->
	<div class="header-tools right-group sl-flex">
		<div class="search-container">
			<Search {...Astro.props} />
		</div>
		<LanguageSelect {...Astro.props} />
		<div class="theme-select-desktop sl-hidden md:sl-flex">
			<ThemeSelect {...Astro.props} />
		</div>
	</div>
</div>

{/* 테마 및 사이드바 접힘 상태 초기화 및 이벤트 리스너 */}
<script is:inline>
	(function() {
		const storageKey = 'starlight-theme';
		const currentTheme = localStorage.getItem(storageKey);
		if (!currentTheme || currentTheme === '') {
			localStorage.setItem(storageKey, 'auto');
		}

		// 사이드바 접힘 상태 복원
		const sidebarKey = 'kinesin-sidebar-collapsed';
		if (localStorage.getItem(sidebarKey) === 'true') {
			document.documentElement.classList.add('sidebar-collapsed');
		}

		// DOM 로드 후 버튼 이벤트 및 단축키(Cmd/Ctrl + B) 바인딩
		function initSidebarToggle() {
			const toggleBtn = document.getElementById('sidebar-toggle-btn');
			if (toggleBtn) {
				toggleBtn.addEventListener('click', () => {
					const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
					localStorage.setItem(sidebarKey, isCollapsed ? 'true' : 'false');
				});
			}

			// 단축키 이벤트
			window.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'b') {
					e.preventDefault();
					const isCollapsed = document.documentElement.classList.toggle('sidebar-collapsed');
					localStorage.setItem(sidebarKey, isCollapsed ? 'true' : 'false');
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initSidebarToggle);
		} else {
			initSidebarToggle();
		}
	})();
</script>

<style>
	.header-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
		width: 100%;
		max-width: var(--kinesin-max-width, 78rem);
		margin: 0 auto;
		padding-inline: 1rem;
		box-sizing: border-box;
	}

	.header-brand {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: calc(var(--sl-sidebar-width, 15rem) - 1rem);
		flex-shrink: 0;
	}

	.brand-title-box {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: inherit;
		min-width: 0;
	}

	.logo-link {
		display: flex;
		align-items: center;
		text-decoration: none;
		background: transparent !important;
		box-shadow: none !important;
	}

	.site-logo {
		display: block;
		height: auto;
		width: 1.75rem;
		background: transparent !important;
		border: none !important;
		filter: none !important;
		box-shadow: none !important;
		padding: 0 !important;
		margin: 0 !important;
	}

	.site-logo--dark {
		display: none;
	}

	:global(html[data-theme='dark']) .site-logo--light {
		display: none;
	}

	:global(html[data-theme='dark']) .site-logo--dark {
		display: block;
	}

	/* 중앙 1depth 카테고리 네비게이션 탭 */
	.header-nav {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin-inline-start: 1rem;
		margin-inline-end: auto;
	}

	.nav-category-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.75rem;
		font-family: 'Plus Jakarta Sans', 'GmarketSans', sans-serif;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--sl-color-gray-3, #78716c);
		background-color: transparent;
		transition: color 0.15s ease;
		line-height: 1.2;
		border-bottom: 2px solid transparent;
		box-sizing: border-box;
	}

	.nav-category-link:hover {
		color: var(--sl-color-text, #1c1917);
		background-color: transparent;
	}

	.nav-category-link.active {
		color: var(--sl-color-text, #1c1917) !important;
		background-color: transparent !important;
		border-bottom: 2px solid var(--sl-color-accent, #3b82f6) !important;
		font-weight: 700;
		box-shadow: none !important;
	}

	:root[data-theme='dark'] .nav-category-link {
		color: var(--sl-color-gray-2, #94a3b8);
	}

	:root[data-theme='dark'] .nav-category-link:hover {
		color: #f8fafc;
		background-color: transparent;
	}

	:root[data-theme='dark'] .nav-category-link.active {
		color: #ffffff !important;
		background-color: transparent !important;
		border-bottom: 2px solid var(--sl-color-accent, #3b82f6) !important;
		box-shadow: none !important;
	}

	/* 우측 도구 그룹 */
	.header-tools {
		display: flex;
		align-items: center;
		gap: var(--sl-nav-gap, 1rem);
		flex-shrink: 0;
	}

	/* 좌측 사이드바 접기/펼치기 데스크톱 토글 버튼 (UI 비노출 처리, 핵심 로직 및 단축키 보존) */
	.sidebar-toggle-btn {
		display: none !important;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border-radius: 8px;
		border: 1px solid var(--sl-color-gray-5, #e2e8f0);
		background-color: transparent;
		color: var(--sl-color-gray-2, #64748b);
		cursor: pointer;
		transition: all 0.15s ease;
		flex-shrink: 0;
	}

	.sidebar-toggle-btn:hover {
		background-color: var(--sl-color-gray-6, #f1f5f9);
		color: var(--sl-color-text, #0f172a);
		border-color: var(--sl-color-gray-4, #cbd5e1);
	}

	:root[data-theme='dark'] .sidebar-toggle-btn {
		border-color: var(--sl-color-gray-5, #334155);
		color: var(--sl-color-gray-2, #94a3b8);
	}

	:root[data-theme='dark'] .sidebar-toggle-btn:hover {
		background-color: var(--sl-color-gray-6, #1e293b);
		color: var(--sl-color-text, #f8fafc);
		border-color: var(--sl-color-gray-4, #475569);
	}

	.sidebar-toggle-btn svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* 모바일 (50rem 이하) 반응형: 슬림 헤더 및 여백 최적화 */
	@media (max-width: 50rem) {
		:global(:root) {
			--sl-nav-height: 2.75rem;
		}

		.header-container {
			padding-inline: 0.85rem;
			height: var(--sl-nav-height, 2.75rem);
		}

		.header-brand {
			width: auto !important;
		}

		.site-logo {
			width: 28px !important;
			height: 28px !important;
		}

		.sidebar-toggle-btn {
			display: none !important;
		}

		.header-nav {
			display: none !important;
		}

		.theme-select-desktop {
			display: none !important;
		}

		.search-container {
			min-width: auto;
		}
	}
</style>
